DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Generate with: openssl rand -base64 48 — never reuse this placeholder as a real value.
JWT_SECRET="REPLACE_ME_GENERATE_YOUR_OWN_SECRET"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# Anthropic (Claude AI) — get from console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
# Model + provider switch for the shared AI client (backend/src/services/ai/aiClient.js).
# Set AI_PROVIDER=mock to run Autopilot fully offline (dev/tests/demo) — no API key needed.
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-4-6"
AI_MAX_RETRIES="2"
# Document/image extraction (e.g. the Import page's PDF/photo ingest) can take
# 30-60s+; keep this generous rather than tuning it down.
AI_TIMEOUT_MS="60000"

# Email (SMTP) — leave blank to use console-log fallback for demo
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Rentora AI" <noreply@rentora.com>'

# SMS (Autopilot maintenance intake) — set SMS_PROVIDER=twilio to send real texts.
# Leave unset (defaults to the mock provider) to run Autopilot's SMS flows fully
# offline: messages are logged to the console and written to the SmsMessage table
# instead of being sent, so the app works without any Twilio account.
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Founding Landlord Pilot ───────────────────────────────────────────────────
# Where new pilot applications are emailed. Leave blank and applications are
# still accepted and stored — only the team notification is skipped (a warning
# is logged server-side; the applicant never sees a configuration message).
PILOT_NOTIFICATION_EMAIL=""

# Public scheduling link (Cal.com, Calendly, or any absolute https URL). When
# set, a successful applicant gets a "Book a 15-minute call" button with their
# name/email/phone/city/units prefilled, and the same link in their confirmation
# email. Leave blank and the flow degrades to "we'll contact you within one
# business day" — submission still works.
BOOKING_URL=""

# Support address shown to an applicant if submission fails. Safe to make public.
PUBLIC_CONTACT_EMAIL=""

# Comma-separated allowlist of user emails that may read and manage pilot
# applications at /admin/pilot-applications. There is no admin role in the
# schema — membership is this list, matched against the authenticated user's own
# email. Empty means nobody: the admin API fails closed.
ADMIN_EMAILS=""

# Number of proxy hops in front of the API, so req.ip (and therefore rate
# limiting) sees the real client address. Defaults to 1 in production, 0 in dev.
# Render/Railway/Vercel are 1.
TRUST_PROXY_HOPS=""

# Test database (Jest integration tests use mocked Prisma by default; only needed
# if you wire up real-DB integration tests against a disposable database).
TEST_DATABASE_URL=""
