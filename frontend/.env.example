# This is a Vite SPA. Browser-visible variables use the VITE_ prefix (Next.js's
# NEXT_PUBLIC_ convention does not apply). Everything under VITE_ is inlined into
# the JS bundle at build time — never put a secret behind one.

# Backend API base URL. Unset in dev — Vite proxies /api to localhost:5000.
VITE_API_URL=

# Demo credential shortcut buttons on /login. Off unless set to "true" — only
# enable on a seeded demo environment, never on a deployment holding real data.
VITE_ENABLE_DEMO_LOGIN=
