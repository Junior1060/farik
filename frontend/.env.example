# This is a Vite SPA. Browser-visible variables use the VITE_ prefix (Next.js's
# NEXT_PUBLIC_ convention does not apply). Everything under VITE_ is inlined into
# the JS bundle at build time — never put a secret behind one.

# Backend API base URL. Unset in dev — Vite proxies /api to localhost:5000.
VITE_API_URL=

# Support address shown to an applicant if the pilot form fails to submit.
VITE_PUBLIC_CONTACT_EMAIL=

# Optional fallback scheduling link. The backend is the source of truth and
# serves the configured link from GET /api/pilot-applications/config; set this
# only if the frontend may be deployed before the API is reachable.
VITE_BOOKING_URL=

# Demo credential shortcut buttons on /login. Shown by default; set to "false"
# on any deployment holding real landlord data.
VITE_ENABLE_DEMO_LOGIN=
